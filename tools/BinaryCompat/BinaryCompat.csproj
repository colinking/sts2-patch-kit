<Project Sdk="Microsoft.NET.Sdk">
    <!-- Standalone dev tool (not part of the mod build); see Program.cs. Excluded from the mod's
         compile via <Compile Remove="tools/**"/> and from the Godot export via tools/.gdignore. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
</Project>
